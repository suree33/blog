{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "prebuild": "pnpm lint",
    "build": "astro build",
    "build:ci": "astro build",
    "build:e2e": "E2E_DRAFT_FIXTURE=true TZ=UTC NODE_OPTIONS=\"$NODE_OPTIONS --import ./tests/e2e/support/network-stub.ts\" astro build --force",
    "preview": "astro preview",
    "preview:workers": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run cf-typegen && eslint && astro check && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "hooks:install": "bash scripts/git-hooks/install.sh",
    "hooks:uninstall": "bash scripts/git-hooks/uninstall.sh",
    "test:git-hooks": "bash tests/git-hooks/hooks.test.sh",
    "test:worker": "node --test tests/worker/*.test.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:update": "pnpm run test:e2e:visual --update-snapshots",
    "test:e2e:update": "playwright test tests/e2e/specs/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/ts-plugin": "1.11.0",
    "@iconify-json/fa6-brands": "1.2.6",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/lucide": "1.2.157",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "astro-icon": "1.2.0",
    "clsx": "2.1.1",
    "file-type": "22.3.0",
    "open-graph-scraper": "6.13.0",
    "parse5": "8.1.1",
    "postcss-nesting": "14.0.3",
    "sanitize-html": "2.18.2",
    "satteri": "0.11.7",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/language-server": "2.17.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/parser": "8.73.0",
    "cheerio": "1.2.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "oxfmt": "0.79.0",
    "typescript-eslint": "8.73.0",
    "typescript-language-server": "6.1.0",
    "undici": "8.13.0",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
