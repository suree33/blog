{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "prebuild": "pnpm lint",
    "build": "astro build",
    "build:ci": "astro build",
    "preview": "astro preview",
    "preview:workers": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint && astro check && tsc --noEmit",
    "hooks:install": "bash scripts/git-hooks/install.sh",
    "hooks:uninstall": "bash scripts/git-hooks/uninstall.sh",
    "test:git-hooks": "bash tests/git-hooks/hooks.test.sh",
    "test:worker": "node --test tests/worker/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test tests/e2e/specs/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/partytown": "2.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/ts-plugin": "1.10.12",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.98",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "postcss-nesting": "^14.0.0",
    "rehype-callouts": "^2.1.2",
    "remark-flexible-code-titles": "^1.3.3",
    "remark-link-card-plus": "^0.8.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.61.0",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.56.1",
    "typescript-language-server": "^6.0.0",
    "wrangler": "^4.69.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
