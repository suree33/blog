---
import { Icon } from 'astro-icon/components';
import ThemeToggle from '@components/ThemeToggle.astro';
import HeaderIcon from '@components/HeaderIcon.astro';
import { socialLinks } from '@lib/social-links';
import { cn } from '@lib/utils';

interface Props {
  class?: string;
}

const { class: classList } = Astro.props;
---

<div class={cn('text-black dark:text-white', classList)}>
  {socialLinks.map(({ href, ariaLabel, icon }) => (
    <HeaderIcon href={href} ariaLabel={ariaLabel}>
      <Icon name={icon} />
    </HeaderIcon>
  ))}
  <ThemeToggle />
</div>
