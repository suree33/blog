---
import { Icon } from 'astro-icon/components';
import config from '@/config.json';
import FooterNav from '@components/FooterNav.astro';
import { socialLinks } from '@lib/social-links';
---

<footer class="mt-12 border-t border-gray-200 py-8 dark:border-neutral-800">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex flex-col items-center gap-4 sm:items-start">
        <a href="/" class="text-xl font-semibold dark:text-white">
          {config.siteName}
        </a>
      </div>

      <FooterNav class="flex flex-wrap justify-center gap-6 text-sm sm:justify-end" />

      <div class="flex items-center gap-4 text-lg">
        {socialLinks.map(({ href, ariaLabel, icon }) => (
          <a
            href={href}
            aria-label={ariaLabel}
            target="_blank"
            class="text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name={icon} />
          </a>
        ))}
        <a
          href="/rss.xml"
          aria-label="RSS feed"
          class="text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        >
          <Icon name="fa6-solid:rss" />
        </a>
      </div>
    </div>
  </div>
</footer>
