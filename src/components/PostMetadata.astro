---
import { Icon } from 'astro-icon/components';
import { formatDate } from '@scripts/date';

export interface Props {
  tags?: string[];
  pubDate?: string;
  updatedDate?: string;
}

const { tags, pubDate, updatedDate } = Astro.props;
const formattedPubDate = pubDate ? formatDate(pubDate) : null;
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
---

<div class="dot-separated flex list-none flex-wrap justify-center gap-x-[0.1em] p-0 text-base font-bold text-neutral-500 uppercase dark:text-neutral-400">
  {tags?.map((tag: string) => (
    <a
      href={`/tags/${tag}`}
      class="inline-flex font-bold text-current no-underline"
    >
      {tag}
    </a>
  ))}
  {pubDate && formattedPubDate && (
    <div>
      <Icon name="fa6-solid:feather" class="mr-1 mb-[.12em] inline text-sm" />
      <time datetime={new Date(pubDate).toISOString()}>{formattedPubDate}</time>
    </div>
  )}
  {updatedDate && formattedUpdatedDate && (
    <div>
      <Icon name="fa6-solid:rotate" class="mr-1 mb-[.12em] inline text-sm" />
      <time datetime={new Date(updatedDate).toISOString()}>
        {formattedUpdatedDate}
      </time>
    </div>
  )}
</div>
