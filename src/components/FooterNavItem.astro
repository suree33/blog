---
import { isNavItemActive } from '@lib/navigation';
import { cn } from '@lib/utils';

const { path, title } = Astro.props;
const { pathname: currentPath } = Astro.url;
const isLinkActive = isNavItemActive(path, currentPath);
---

<a
  href={path}
  class={cn(
    'text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white',
    { 'font-medium text-gray-900 dark:text-white': isLinkActive },
  )}
>
  {title}
</a>
