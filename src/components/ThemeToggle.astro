---
import { Icon } from 'astro-icon/components';
import { cn } from '@lib/utils';
import HeaderIcon from '@components/HeaderIcon.astro';

interface Props {
  class?: string;
}

const { class: classList } = Astro.props;
---

<HeaderIcon
  class={cn(classList)}
  ariaLabel="テーマを切り替える"
  data-theme-toggle
>
  <Icon
    name="lucide:sun-moon"
    class="hidden [html:not(.light):not(.dark)_&]:block"
  />
  <Icon name="lucide:moon" class="hidden in-[html.dark]:block" />
  <Icon name="lucide:sun" class="hidden in-[html.light]:block" />
</HeaderIcon>

<script>
  import { isTheme, THEMES, type Theme } from '@/types/Theme';
  type ThemeState = Theme | null;

  const html = document.documentElement;

  /**
   * localStorage からテーマを取得する
   *
   * 'light' でも 'dark' でもない場合は null を返す
   */
  const getStoredTheme = (): ThemeState => {
    try {
      const storedTheme = localStorage.getItem('theme') ?? '';
      if (isTheme(storedTheme)) {
        return storedTheme;
      }
    } catch {
      // 保存領域が使えない場合はシステム設定に従う。
    }
    return null;
  };

  const storeTheme = (theme: ThemeState) => {
    try {
      if (theme === null) {
        window.localStorage.removeItem('theme');
      } else {
        window.localStorage.setItem('theme', theme);
      }
    } catch {
      // 保存できなくてもページ内の切り替えは続ける。
    }
  };

  /**
   * OS のテーマ設定を取得する
   */
  const getSystemTheme = (): Theme => {
    const isDarkPreferred = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches;
    return isDarkPreferred ? 'dark' : 'light';
  };

  /**
   * 指定されたテーマを適用する
   *
   * 指定されたテーマを `<html>` のクラスに追加し、 localStorage に保存する。
   * null の場合はクラスと保存値を外し、システム設定に従う
   *
   * @param theme
   */
  const applyTheme = (theme: ThemeState) => {
    html.classList.remove(...THEMES);
    if (theme !== null) {
      html.classList.add(theme);
    }
    html.style.colorScheme = theme ?? 'light dark';
    storeTheme(theme);
  };

  /**
   * 現在適用されているテーマを <html> のクラスから取得する
   *
   * 'light' も 'dark' もどちらも適用されていない場合は null を返す
   */
  const getCurrentTheme = (): ThemeState =>
    THEMES.find((theme) => html.classList.contains(theme)) ?? null;

  applyTheme(getStoredTheme());

  const handleToggleClick = () => {
    const currentTheme = getCurrentTheme();
    const systemTheme = getSystemTheme();

    if (currentTheme === null) {
      applyTheme(systemTheme === 'dark' ? 'light' : 'dark');
      return;
    }

    if (currentTheme !== systemTheme) {
      applyTheme(systemTheme);
      return;
    }

    applyTheme(null);
  };

  document
    .querySelectorAll<HTMLElement>('[data-theme-toggle]')
    .forEach((toggleButton) => {
      toggleButton.addEventListener('click', handleToggleClick);
    });
</script>
