---
import type { MarkdownHeading } from 'astro';
import type { StandalonePageFrontmatter } from '@/types/Post';
import PostMetadata from '@components/PostMetadata.astro';
import ProseArticleLayout from '@layouts/ProseArticleLayout.astro';
import TableOfContents from '@components/TableOfContents.astro';

interface Props {
  frontmatter: StandalonePageFrontmatter;
  headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const { ogimage } = frontmatter;
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<ProseArticleLayout
  ogType="article"
  pageTitle={frontmatter.title}
  ogimage={typeof ogimage === 'string' ? ogimage : ogimage?.src}
  ogImageAlt={typeof ogimage === 'string' ? undefined : ogimage?.alt}
  description={frontmatter.description}
  tocHeadings={tocHeadings}
>
  <slot name="head" slot="head" />
  <PostMetadata
    tags={frontmatter.tags}
    pubDate={frontmatter.pubDate}
    updatedDate={frontmatter.updatedDate ?? undefined}
  />
  <h1>{frontmatter.title}</h1>
  {frontmatter.image && (
    <img
      class="rounded"
      src={frontmatter.image.src}
      alt={frontmatter.image.alt}
    />
  )}
  {frontmatter.description && (
    <p class="rounded bg-neutral-100 px-4 py-3 text-left dark:bg-neutral-800">
      {frontmatter.description}
    </p>
  )}
  {tocHeadings.length > 0 && (
    <TableOfContents headings={tocHeadings} class="my-5 block xl:hidden" />
  )}
  <slot />
</ProseArticleLayout>
