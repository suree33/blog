---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import config from '@/config.json';
import '@styles/global.css';
import { cn } from '@lib/utils';

interface Props {
  pageTitle?: string;
  ogimage?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { pageTitle, ogimage, description, ogType = 'website' } = Astro.props;
---

<html lang="ja" class="motion-safe:scroll-smooth">
  <head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/ fb# article: http://ogp.me/ns/article#">
    <meta charset="utf-8" />
    <script is:inline>
      // FOUC抑止のためにテーマ初期化
      (() => {
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem('theme');
        } catch {
          // 保存領域が使えない場合はシステム設定に従う。
        }
        const html = document.documentElement;

        html.classList.remove('light', 'dark');

        if (storedTheme === 'light' || storedTheme === 'dark') {
          html.classList.add(storedTheme);
          html.style.colorScheme = storedTheme;
          return;
        }

        html.style.colorScheme = 'light dark';
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={description ? description : config.description}
    />
    <title>{pageTitle} — {config.siteName}</title>
    <!-- og -->
    <meta property="og:site_name" content={config.siteName} />
    <meta
      property="og:title"
      content={
        pageTitle ? pageTitle + ' — ' + config.siteName : config.siteName
      }
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta
      property="og:description"
      content={description ? description : config.description}
    />
    <meta
      property="og:image"
      content={
        new URL(ogimage || config.ogImage, Astro.site ?? Astro.url.origin)
      }
    />
    <meta property="og:locale" content="ja_JP" />
    <!-- Google Analytics -->
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-8ZCMEEKWF9"
    ></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        window.dataLayer.push(args);
      }
      gtag('js', new Date());
      gtag('config', 'G-8ZCMEEKWF9');
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white dark:bg-neutral-950">
    <a
      href="#main-content"
      class={cn(
        'sr-only focus:not-sr-only',
        'focus:block focus:w-full focus:shrink-0 focus:px-4 focus:py-3 focus:text-center focus:font-bold',
        'focus:bg-neutral-100 focus:text-neutral-950 dark:focus:bg-neutral-900 dark:focus:text-white',
        'focus:outline-2 focus:-outline-offset-4 focus:outline-blue-700 dark:focus:outline-blue-300',
      )}
    >
      本文へスキップ
    </a>
    <Header />
    <main
      id="main-content"
      tabindex="-1"
      class="grow scroll-mt-24 sm:scroll-mt-28"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
