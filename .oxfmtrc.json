{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "astro": {},
  "ignorePatterns": [
    ".astro/",
    ".dist/",
    "node_modules/",
    "pnpm-lock.yaml",
    "worker-configuration.d.ts",
    ".claude/",
    ".mcp.json",
    ".cursor/",
    ".worktrees/",
    ".wt/",
    "src/content/posts/.obsidian/",
    "*.md",
    "*.mdx"
