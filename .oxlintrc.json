{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "globals": {
    "dataLayer": "readonly"
  },
  "ignorePatterns": [
    ".worktrees/**",
    ".wt/**",
    "worker-configuration.d.ts",
    "**/*.astro"
  ],
  "rules": {
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "inline-type-imports" }
    ]
  }
}
